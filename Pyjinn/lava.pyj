#!python
from system.pyj.minescript import *
import minescript as m

# Java Class Bindings via Pyjinn
Minecraft = JavaClass("net.minecraft.client.Minecraft")
Blocks = JavaClass("net.minecraft.world.level.block.Blocks")
MutableBlockPos = JavaClass("net.minecraft.core.BlockPos$MutableBlockPos")

# Rendering Bindings
Gizmos = JavaClass("net.minecraft.gizmos.Gizmos")
GizmoStyle = JavaClass("net.minecraft.gizmos.GizmoStyle")
AABB = JavaClass("net.minecraft.world.phys.AABB")
ARGB = JavaClass("net.minecraft.util.ARGB")

mc = Minecraft.getInstance()
mutable_pos = MutableBlockPos()

# Color configurations
lava_high_box = GizmoStyle.strokeAndFill(ARGB.color(255, 0, 100, 255), JavaFloat(1.5), ARGB.color(50, 0, 100, 255))
lava_mid_box  = GizmoStyle.strokeAndFill(ARGB.color(255, 255, 50, 50), JavaFloat(1.5), ARGB.color(50, 255, 50, 50))

# Target Region Boundaries for High Lava (Blue Box)
TARGET_X_MIN, TARGET_X_MAX = 560, 823
TARGET_Z_MIN, TARGET_Z_MAX = 516, 823
Y_MIN_SCAN, Y_MAX_SCAN = 63, 187

# 8 chunks * 16 blocks = 128 block radius
RENDER_DISTANCE_BLOCKS = 128

cached_render_boxes = []
scan_finished = True
scanner_instance = None

def get_block_fast(x, y, z):
    if mc.level is None:
        return None
    return mc.level.getBlockState(mutable_pos.set(x, y, z)).getBlock()

def background_lava_scanner(player_x, player_z):
    """
    Scans the loaded 8-chunk radius:
    - Red boxes (Y=63-64): Scanned across the ENTIRE 8-chunk render distance.
    - Blue boxes (Y>=65): Scanned ONLY within the specified target region.
    """
    # 1. Full 8-chunk boundary around player
    loaded_x_min = player_x - RENDER_DISTANCE_BLOCKS
    loaded_x_max = player_x + RENDER_DISTANCE_BLOCKS
    loaded_z_min = player_z - RENDER_DISTANCE_BLOCKS
    loaded_z_max = player_z + RENDER_DISTANCE_BLOCKS

    echo(f"§e[RADAR] Scanning 8-chunk radius around player (X: {loaded_x_min} to {loaded_x_max}, Z: {loaded_z_min} to {loaded_z_max})...")

    blocks_per_tick = 50000
    blocks_scanned_this_tick = 0
    match_count = 0

    for x in range(loaded_x_min, loaded_x_max + 1):
        for z in range(loaded_z_min, loaded_z_max + 1):
            
            # Check if this (x, z) column is within the specific target zone for Blue boxes
            in_blue_zone = (TARGET_X_MIN <= x <= TARGET_X_MAX) and (TARGET_Z_MIN <= z <= TARGET_Z_MAX)

            for y in range(Y_MIN_SCAN, Y_MAX_SCAN + 1):
                block = get_block_fast(x, y, z)

                if block == Blocks.LAVA:
                    # Blue Box (High Lava): RESTRICTED to target region
                    if y >= 65 and in_blue_zone:
                        box = AABB(JavaFloat(x), JavaFloat(y), JavaFloat(z), 
                                   JavaFloat(x + 1.0), JavaFloat(y + 1.0), JavaFloat(z + 1.0))
                        cached_render_boxes.append((box, lava_high_box))
                        match_count += 1

                    # Red Box (Mid-level Lava): UNRESTRICTED across entire 8-chunk radius
                    elif y == 63 or y == 64:
                        # Verify base block is 1-tall
                        if get_block_fast(x, y + 1, z) != Blocks.LAVA and get_block_fast(x, y - 1, z) != Blocks.LAVA:
                            
                            # Attempt +X pair
                            if get_block_fast(x + 1, y, z) == Blocks.LAVA:
                                if get_block_fast(x + 1, y + 1, z) != Blocks.LAVA and get_block_fast(x + 1, y - 1, z) != Blocks.LAVA:
                                    box = AABB(JavaFloat(x), JavaFloat(y), JavaFloat(z), 
                                               JavaFloat(x + 2.0), JavaFloat(y + 1.0), JavaFloat(z + 1.0))
                                    cached_render_boxes.append((box, lava_mid_box))
                                    match_count += 1

                            # Attempt +Z pair
                            if get_block_fast(x, y, z + 1) == Blocks.LAVA:
                                if get_block_fast(x, y + 1, z + 1) != Blocks.LAVA and get_block_fast(x, y - 1, z + 1) != Blocks.LAVA:
                                    box = AABB(JavaFloat(x), JavaFloat(y), JavaFloat(z), 
                                               JavaFloat(x + 1.0), JavaFloat(y + 1.0), JavaFloat(z + 2.0))
                                    cached_render_boxes.append((box, lava_mid_box))
                                    match_count += 1

                blocks_scanned_this_tick += 1

                if blocks_scanned_this_tick >= blocks_per_tick:
                    yield False
                    blocks_scanned_this_tick = 0

    echo(f"§a§l[RADAR] §rScan complete! Found {match_count} valid segments/blocks.")
    echo("§lCOLOR SCHEME")
    echo("§1█§r: Worm Fishing")
    echo("§4█§r: Magma Core Fishing")
    yield True

def start_scan(event):
    """Press Mouse Button 4 (or Middle Click depending on your mouse) to trigger the scan."""
    global scan_finished, scanner_instance, cached_render_boxes

    if event.button == 3 and event.action == 1:
        if mc.player is not None:
            cached_render_boxes.clear()
            ppos = mc.player.position()
            scanner_instance = background_lava_scanner(int(ppos.x), int(ppos.z))
            scan_finished = False

def on_tick(event):
    global scan_finished
    if not scan_finished and scanner_instance is not None:
        try:
            if next(scanner_instance) == True:
                scan_finished = True
        except StopIteration:
            scan_finished = True

def on_render(event):
    for box, style in cached_render_boxes:
        try:
            Gizmos.cuboid(box, style).setAlwaysOnTop()
        except:
            pass

add_event_listener("tick", on_tick)
add_event_listener("render", on_render)
add_event_listener("mouse", start_scan)

m.echo("§d[RADAR Ready] Click Mouse Button 4 to scan the 8-chunk radius around you.")
